{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@root/*": ["./*"],
      "@prisma": ["./lib/prisma"],
      "@models": ["./generated/prisma/client"],
      "@helpers/*": ["./src/helpers/*"]
    }
  },
  "include": ["src/**/*", "src/config", "src/services/transaction/.ts"],
  "exclude": ["node_modules"]
}
